{
  "manifest_version": 3,
  "name": "Rebuildr — Swarm Rebuild Studio v3.6",
  "version": "3.6.0",
  "description": "Deconstructs any live website and rebuilds it from scratch using 8 multiplayer AI cursors, AI Layout Curator, Before/After Hooks & Rich Synth SFX.",
  "action": {
    "default_title": "Rebuildr Studio (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Rebuild this page with Rebuildr Studio"
    }
  }
}

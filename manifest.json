{
  "manifest_version": 3,
  "name": "Swarm Rebuild Studio v2.0",
  "version": "2.0.0",
  "description": "Live DOM Scene-Aware multiplayer cursor builder for website showcase & promo videos.",
  "action": {
    "default_title": "Swarm Rebuild Studio (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Rebuild this page with Swarm Studio"
    }
  }
}
